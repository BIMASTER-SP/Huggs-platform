# ============================================================
# Ruby Rose B2B API - Environment Variables
# ============================================================
# Copie este arquivo para `.env` e preencha os valores reais.
# `.env` está no .gitignore — NUNCA commite credenciais.
#
# Para gerar JWT_SECRET com 256 bits de entropia:
#   openssl rand -hex 32
# ============================================================

# === OBRIGATORIO ===
JWT_SECRET=cole-aqui-32+caracteres-de-entropia-aleatoria-gerados-com-openssl-rand-hex-32

# === OPCIONAIS (com defaults seguros) ===
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS: origens permitidas, separadas por virgula. Default = http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://rubyrose.example.com

# Logging
LOG_LEVEL=INFO

# Rate limiting (formato slowapi: "N/intervalo", ex: "5/minute", "100/hour")
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/hour
RATE_LIMIT_CUPOM_LOOKUP=10/minute

# === FUTURO (PR 2 - banco real) ===
# DATABASE_URL=sqlite:///./rubyrose.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/rubyrose
